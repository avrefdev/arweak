{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Arweak",
  "version": "1.0.0",
  "identifier": "app.arweak",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Arweak",
        "width": 1040,
        "height": 660,
        "resizable": false,
        "maximizable": false,
        "decorations": false,
        "shadow": true,
        "center": true,
        "visible": false,
        "backgroundColor": "#0b0c0f"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "publisher": "Arweak",
    "shortDescription": "Oyun performans aracı",
    "longDescription": "Oyunlar için Windows performans ve akıcılık aracı.",
    "license": "GPL-3.0-or-later",
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": {
        "installMode": "perMachine",
        "languages": ["Turkish", "English"],
        "displayLanguageSelector": false
      }
    }
  }
}
